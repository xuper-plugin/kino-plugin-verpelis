{
  "id": "verpelis",
  "name": "VerPelis",
  "version": "0.1.10",
  "apiVersion": 30,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Películas de verpelis.gratis. Resuelve los hosters con el plugin Kino Resolver.",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-verpelis",
  "hosts": [
    "verpelis.gratis"
  ],
  "streamHosts": "any",
  "recommends": [
    "xuper-plugin/kino-plugin-kino-resolver"
  ],
  "browser": true,
  "fetchHosts": "any",
  "capabilities": [
    "search",
    "resolve",
    "screen"
  ],
  "screen": {
    "label": "VerPelis",
    "labelEn": "VerPelis",
    "icon": "movie",
    "menuOpens": "screen",
    "opensFrom": [
      "menu",
      "settings"
    ],
    "settingsIn": "screen",
    "settingsButton": {
      "label": "Abrir VerPelis",
      "labelEn": "Open VerPelis"
    }
  },
  "consumes": {
    "resolver": {
      "repo": "xuper-plugin/kino-plugin-kino-resolver",
      "door": "resolver",
      "calls": [
        "resolve",
        "rank"
      ]
    }
  },
  "provides": {
    "catalog": {
      "summary": "Titles this plugin finds, for the author's other plugins",
      "calls": {
        "search": {
          "in": {
            "q": "string",
            "type": "string?"
          },
          "out": "Item[]"
        }
      },
      "types": {
        "Item": {
          "id": "string",
          "ref": "string",
          "title": "string",
          "kind": "string",
          "poster": "string?",
          "backdrop": "string?",
          "year": "string?",
          "overview": "string?",
          "tmdb": "number?"
        }
      }
    }
  },
  "signature": {
    "authorKey": "6693946bd5c56196960959c4b9665fad5094374bcb85ddb282f8bf762c835263",
    "value": "ab4365f6d8bc0c47511543f3f6364105abcd1ea5596fd4cac60941d102e5c18fdd4a894ab22b8af3175d584b9c8c1e80a71b19151ace4d319d9cee887091960d"
  }
}
