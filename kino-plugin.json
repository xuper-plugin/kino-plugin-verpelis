{
  "id": "verpelis",
  "name": "VerPelis",
  "version": "0.1.7",
  "apiVersion": 30,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Películas y series de verpelis.gratis. Resuelve los hosters con el plugin Kino Resolver.",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-verpelis",
  "hosts": [
    "verpelis.gratis"
  ],
  "streamHosts": "any",
  "recommends": [
    "xuper-plugin/kino-plugin-kino-resolver"
  ],
  "browser": true,
  "fetchHosts": "any",
  "capabilities": [
    "search",
    "resolve",
    "episodes",
    "screen"
  ],
  "screen": {
    "label": "VerPelis",
    "labelEn": "VerPelis",
    "icon": "movie",
    "menuOpens": "screen",
    "opensFrom": [
      "menu",
      "settings"
    ],
    "settingsIn": "screen",
    "settingsButton": {
      "label": "Abrir VerPelis",
      "labelEn": "Open VerPelis"
    }
  },
  "consumes": {
    "resolver": {
      "repo": "xuper-plugin/kino-plugin-kino-resolver",
      "door": "resolver",
      "calls": [
        "resolve",
        "rank"
      ]
    }
  },
  "provides": {
    "catalog": {
      "summary": "Titles this plugin finds, for the author's other plugins",
      "calls": {
        "search": {
          "in": {
            "q": "string",
            "type": "string?"
          },
          "out": "Item[]"
        }
      },
      "types": {
        "Item": {
          "id": "string",
          "ref": "string",
          "title": "string",
          "kind": "string",
          "poster": "string?",
          "backdrop": "string?",
          "year": "string?",
          "overview": "string?",
          "tmdb": "number?"
        }
      }
    }
  },
  "signature": {
    "authorKey": "6693946bd5c56196960959c4b9665fad5094374bcb85ddb282f8bf762c835263",
    "value": "abc0f60cf86840fb78276aadbb32a8560be7c1bc84f0be0986a9c319d789817997f99d1734fa6e42438bd2bfb13a5264732cb2e8d89c8eb8609399e6e02b9b0b"
  }
}
